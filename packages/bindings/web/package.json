{
  "name": "@taladb/web",
  "version": "0.11.8",
  "description": "TalaDB WASM bindings — document queries and vector search in the browser",
  "main": "pkg/taladb_web.js",
  "types": "pkg/taladb_web.d.ts",
  "exports": {
    ".": {
      "import": "./pkg/taladb_web.js",
      "types": "./pkg/taladb_web.d.ts"
    },
    "./pkg/*": "./pkg/*",
    "./worker/*": "./worker/*"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "pkg/",
    "worker/"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg --release",
    "build:dev": "wasm-pack build --target web --out-dir pkg --dev",
    "test": "wasm-pack test --headless --chrome",
    "test:e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tala-sh/taladb.git",
    "directory": "packages/bindings/web"
  },
  "homepage": "https://taladb.dev/guide/web",
  "bugs": {
    "url": "https://github.com/tala-sh/taladb/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT OR Apache-2.0"
}
