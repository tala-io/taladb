target/
node_modules/

# Build output. These are `**/` rather than `packages/*/` on purpose: the
# single-star form only reaches one level, so it never matched the packages
# that actually live two deep (packages/clients/taladb, packages/bindings/web).
# Their build output was tracked as a result, and a stale committed `dist/`
# is worse than none — it is what `npm publish` ships.
**/dist/
**/pkg/
*.node

# Scratch databases. Opening a database creates a file; test runs and manual
# pokes around the bindings leave them behind, and they are large.
*.db
*.db-lock
*.redb

.DS_Store

# VitePress build output and cache — generated by `pnpm docs:build`, not source.
docs/.vitepress/cache/

# Working plans. Personal notes-to-self, not documentation — they go stale and
# contradict docs/ the moment the work lands.
PLAN-*.md
.gstack/
reviews/

# internal docs
ROADMAP-INTERNAL.md
